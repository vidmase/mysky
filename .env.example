# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Base URL for OAuth redirects (optional - automatically determined)
# For local development: http://localhost:3000
# For production: https://mysky.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Mapbox Configuration
# Public client token (must start with pk.)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token

# Cron secret for secured ingestion endpoint
# Used as header: x-cron-secret: <CRON_SECRET>
CRON_SECRET=your_strong_cron_secret

# Other environment variables...
# Live Google Flights search (gfscrape FastAPI) — server-side proxy only
# Used by POST /api/live-search and GET /api/live-search/health
#
# IMPORTANT: Vercel mock frontend cannot run Playwright. Point this at a
# durable FastAPI host from vidmase/gfscrape (Docker/VPS/Railway/Fly/Render).
# Do NOT leave an ephemeral localtunnel/cloudflared URL in production.
#
# Default below is the gfscrape Vercel mock edge (fixtures only).
FLIGHTS_API_URL=https://gfscrape-git-main-vidmases-projects.vercel.app
# Example durable host (set in Vercel project "mysky" only):
# FLIGHTS_API_URL=https://flights-api.example.com
