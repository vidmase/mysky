# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Base URL for OAuth redirects (optional - automatically determined)
# For local development: http://localhost:3000
# For production: https://mysky.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PROJECT_ID=your_supabase_project_ref

# Mapbox Configuration
# Public client token (must start with pk.)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token

# Cron secret for secured ingestion endpoint
# Used as header: x-cron-secret: <CRON_SECRET>
CRON_SECRET=your_strong_cron_secret

# DeepSeek (used by POST /api/chat)
# Optional fallback: each user can store their own key from the chat UI, which
# takes precedence over this one. Without either, chat asks for a key.
DEEPSEEK_API_KEY=your_deepseek_api_key

# Encrypts the per-user API keys in the user_api_keys table (AES-256-GCM).
# Required for the "Add key" dialog in chat. At least 32 characters.
# Generate with: openssl rand -base64 32
# Changing this makes every already-stored key undecryptable.
API_KEY_ENCRYPTION_SECRET=your_32_char_or_longer_random_secret

# Other environment variables...
# Live Google Flights search (gfscrape) — server-side proxy only
# Used by POST /api/live-search and GET /api/live-search/health
FLIGHTS_API_URL=https://gfscrape-git-main-vidmases-projects.vercel.app
